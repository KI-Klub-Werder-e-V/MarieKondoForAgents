{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KI-Klub-Werder-e-V/MarieKondoFuerAgenten/schemas/golden-set.schema.json",
  "title": "KonMari-Kit golden question set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "questions"
  ],
  "properties": {
    "version": {
      "type": [
        "integer",
        "string"
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "author",
          "expected_behaviour",
          "expected_answer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "expected_behaviour": {
            "enum": [
              "answer",
              "abstain",
              "flag_conflict"
            ]
          },
          "expected_answer": {
            "type": "string",
            "minLength": 1
          },
          "expected_source": {
            "type": "string",
            "minLength": 1
          },
          "contains_personal_data": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
