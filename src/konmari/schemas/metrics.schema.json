{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KI-Klub-Werder-e-V/MarieKondoForAgents/schemas/metrics.schema.json",
  "title": "KonMari-Kit success metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "charter_id",
    "golden_set",
    "metrics"
  ],
  "properties": {
    "charter_id": {
      "type": "string",
      "minLength": 1
    },
    "golden_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "min_questions": {
          "type": "integer",
          "minimum": 30
        },
        "min_abstention": {
          "type": "integer",
          "minimum": 5
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "family",
          "unit",
          "formula",
          "data_source",
          "method",
          "owner",
          "target",
          "direction",
          "tier",
          "cadence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "enum": [
              "answer_quality",
              "abstention",
              "data_readiness",
              "business_outcome",
              "governance"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "formula": {
            "type": "string",
            "minLength": 1
          },
          "data_source": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "number"
          },
          "direction": {
            "enum": [
              ">=",
              "<="
            ]
          },
          "tier": {
            "enum": [
              "must_have",
              "target",
              "stretch"
            ]
          },
          "cadence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
